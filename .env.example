# Set to your actual verified public domain before deployment.
NEXT_PUBLIC_SITE_URL=https://your-literaryworks-domain.example

# Contact form email through SendGrid (https://www.twilio.com/docs/sendgrid/api-reference/mail-send)
# An API key with only the "Mail Send" permission.
SENDGRID_API_KEY=
# Who receives new inquiries (a comma-separated list is fine).
CONTACT_TO_EMAIL=
# The sender: an address verified in SendGrid (Single Sender or an authenticated domain).
CONTACT_FROM_EMAIL=

# Optional
# The sender name shown in inboxes (default: LiteraryWorks).
CONTACT_FROM_NAME=
# Where the visitor's confirmation tells them to write (default: the first CONTACT_TO_EMAIL).
CONTACT_REPLY_EMAIL=
# Set to false to stop sending visitors a confirmation email.
CONTACT_SEND_CONFIRMATION=
# https://api.eu.sendgrid.com for an EU-region SendGrid account (default: https://api.sendgrid.com).
SENDGRID_API_BASE=

# The website assistant (the chat in the corner) through OpenAI's Responses API.
# A project API key; without it the chat button still shows and answers with a pointer to the contact form.
OPENAI_API_KEY=

# Optional
# The model (default: gpt-4.1-mini, fast and inexpensive).
OPENAI_MODEL=
# Only for reasoning models (gpt-5 family, o-series): low effort keeps the first word fast, for example "minimal" or "low".
OPENAI_REASONING_EFFORT=
# The longest answer, in tokens (default: 700).
OPENAI_MAX_OUTPUT_TOKENS=
# Another OpenAI-compatible endpoint (default: https://api.openai.com).
OPENAI_API_BASE=
