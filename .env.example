# Set to your actual verified public domain before deployment.
NEXT_PUBLIC_SITE_URL=https://your-literaryworx-domain.example

# Contact form email through SendGrid (https://www.twilio.com/docs/sendgrid/api-reference/mail-send)
# An API key with only the "Mail Send" permission.
SENDGRID_API_KEY=
# Who receives new inquiries (a comma-separated list is fine).
CONTACT_TO_EMAIL=
# The sender: an address verified in SendGrid (Single Sender or an authenticated domain).
CONTACT_FROM_EMAIL=

# Optional
# The sender name shown in inboxes (default: Literary Worx).
CONTACT_FROM_NAME=
# Where the visitor's confirmation tells them to write (default: the first CONTACT_TO_EMAIL).
CONTACT_REPLY_EMAIL=
# Set to false to stop sending visitors a confirmation email.
CONTACT_SEND_CONFIRMATION=
# https://api.eu.sendgrid.com for an EU-region SendGrid account (default: https://api.sendgrid.com).
SENDGRID_API_BASE=

# The admin area (/admin): the contact form's messages in a private inbox behind a sign-in.
# 1. Connect a store (this is all the host needs):
#    MongoDB Atlas (a free M0 cluster is enough): the connection string from Atlas > Connect > Drivers, with the
#    database user's password filled in. On Atlas, Network Access must let the host in (Vercel's addresses change,
#    so it needs 0.0.0.0/0 there; the database user's password is what protects the data).
MONGODB_URI=
# Optional: the database's name (default: the one in the string, else "literaryworx").
MONGODB_DB=
#    or Redis (Vercel: Storage > Redis): KV_REST_API_URL and KV_REST_API_TOKEN (UPSTASH_REDIS_REST_URL and _TOKEN work too).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# 2. Open /admin once: the first visit asks for an e-mail address and a password and makes the admin account
#    (stored in the database as a scrypt hash, never as text). Nothing else to set. Do it right away: until it is done,
#    anyone who opens the page could make the account. To be safe, set ADMIN_SETUP_KEY to a word only you know and the
#    form asks for it too.
ADMIN_SETUP_KEY=

# Optional
# Two-step sign-in with an authenticator app (`npm run admin:setup` makes a key). Strongly recommended.
ADMIN_TOTP_SECRET=
# How long a sign-in lasts, in hours (default: 8; 1 to 72).
ADMIN_SESSION_HOURS=
# Instead of the first-run form, the account can come from the host's settings: `npm run admin:setup` prints these three.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Signs the session cookie: 32+ random characters. Changing it signs everyone out.
ADMIN_SESSION_SECRET=
# LW_STORE=file keeps the inbox in .data/store.json instead: for a server that keeps its disk, never for Vercel.
# (In development with no store settings the file is used by itself.)
LW_STORE=

# The website assistant (the chat in the corner) through Anthropic's Claude (the official SDK, @anthropic-ai/sdk).
# An API key from console.anthropic.com; set a monthly spend limit there. Without it the chat answers with a pointer to the contact form.
ANTHROPIC_API_KEY=

# Optional
# The model (default: claude-opus-5-5).
ANTHROPIC_MODEL=
# The longest answer, in tokens (default: 2000).
ANTHROPIC_MAX_TOKENS=
